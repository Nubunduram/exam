# Variables pour l'environnement LOCAL (docker-compose.yml). Copier en .env et remplir.
# Générer un secret robuste : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
ORDER_NOTIFY_EMAIL=
# Pour lancer sans Docker (npm run start:all)
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
PORT=5000
GATEWAY_PORT=8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003
