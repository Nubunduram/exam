# Fichier /opt/exam/<preprod|prod>/.env sur le serveur (une copie par environnement, jamais commitée)
APP_ENV=preprod                     # preprod | prod
IMAGE_TAG=preprod                   # tag des images GHCR (preprod | prod)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/exam_preprod?retryWrites=true&w=majority
JWT_SECRET=                         # secret différent par environnement (48 octets aléatoires)
NOTIFY_API_KEY=                     # clé partagée backend <-> microservice notifications (openssl rand -hex 32)
CORS_ORIGIN=https://preprod.exam-domain-name.duckdns.org
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
ORDER_NOTIFY_EMAIL=
