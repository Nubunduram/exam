{
  "source": {
    "include": ["server.js", "config", "controllers", "middlewares", "models", "routes", "validators", "createAdmin.js"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(node_modules|tests)"
  },
  "opts": {
    "destination": "../docs/api",
    "recurse": true,
    "encoding": "utf8",
    "readme": "../README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": { "cleverLinks": true }
}
